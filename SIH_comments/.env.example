# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/audience_intel
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/audience_intel

# ── Scraper ───────────────────────────────────────────────────
ACCOUNTS_FILE=accounts.txt
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300

# ── NLP / Models ──────────────────────────────────────────────
# "cpu" or "cuda" (GPU). CPU is the safe default.
DEVICE=cpu
# Directory for caching HuggingFace models
HF_CACHE_DIR=models_cache
# Google Cloud Translation API Key (optional - leave blank to use free GoogleTranslator)
# GOOGLE_TRANSLATE_API_KEY=your_key_here
# Path to emotion dataset for ML training
EMOTION_CSV_PATH=emotions/tweet_emotions.csv

# ── Trends ────────────────────────────────────────────────────
TREND_WINDOW_MINUTES=15
TREND_TOP_N=20

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
